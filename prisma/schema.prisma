generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())

  bookings   Booking[]
  savedTrips SavedTrip[]
}

model Destination {
  id      Int    @id
  name    String
  country String
  image   String

  bookings   Booking[]
  savedTrips SavedTrip[]
}

model Hotel {
  id       Int    @id
  name     String
  location String
  image    String
  price    Int
  rating   Float

  bookings Booking[]
}

model Booking {
  id     String @id @default(cuid())
  userId String

  hotelId       Int?
  destinationId Int?

  hotelName     String?
  hotelLocation String?
  hotelImage    String?
  hotelPrice    Int?
  hotelRating   Float?

  checkIn  DateTime
  checkOut DateTime
  guests   Int
  rooms    Int
  total    Int

  status    String   @default("Confirmed")
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel       Hotel?       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model SavedTrip {
  id            String   @id @default(cuid())
  userId        String
  destinationId Int
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}
